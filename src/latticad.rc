// Embed the application manifest so Windows runs latticad with a UTF-8 active
// code page (SetupEnvironment() asserts GetACP() == CP_UTF8).

#include <winuser.h> // for CREATEPROCESS_MANIFEST_RESOURCE_ID and RT_MANIFEST

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "latticad.manifest"
