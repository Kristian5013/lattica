#!/usr/bin/env bash
#
#  latticad The Lattica server.
#
#
# chkconfig: 345 80 20
# description: latticad
# processname: latticad
#

# Source function library.
. /etc/init.d/functions

# you can override defaults in /etc/sysconfig/latticad, see below
if [ -f /etc/sysconfig/latticad ]; then
        . /etc/sysconfig/latticad
fi

RETVAL=0

prog=latticad
# you can override the lockfile via LATTICAD_LOCKFILE in /etc/sysconfig/latticad
lockfile=${LATTICAD_LOCKFILE-/var/lock/subsys/latticad}

# latticad defaults to /usr/bin/latticad, override with LATTICAD_BIN
latticad=${LATTICAD_BIN-/usr/bin/latticad}

# latticad opts default to -disablewallet, override with LATTICAD_OPTS
latticad_opts=${LATTICAD_OPTS--disablewallet}

start() {
    echo -n $"Starting $prog: "
    daemon $DAEMONOPTS $latticad $latticad_opts
    RETVAL=$?
    echo
    [ $RETVAL -eq 0 ] && touch $lockfile
    return $RETVAL
}

stop() {
    echo -n $"Stopping $prog: "
    killproc $prog -t600
    RETVAL=$?
    echo
    [ $RETVAL -eq 0 ] && rm -f $lockfile
    return $RETVAL
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    status)
        status $prog
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: service $prog {start|stop|status|restart}"
        exit 1
        ;;
esac
